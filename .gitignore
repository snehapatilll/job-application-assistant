# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
server/.env
client/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.tsbuildinfo
coverage/

# CA bundles are fetched, not committed — Amazon rotates them, and a stale
# bundle in git is worse than no bundle.
server/certs/*.pem
