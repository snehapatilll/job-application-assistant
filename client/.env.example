# ---------------------------------------------------------------------------
# Client environment variables (Vite exposes only VITE_-prefixed vars).
# Copy this file to `.env` if you need to override defaults.
# ---------------------------------------------------------------------------

# In development the client calls the backend through Vite's proxy at "/api",
# so no base URL is required. Set this only if you deploy the client separately
# from the API and need an absolute URL.
# VITE_API_BASE_URL=
