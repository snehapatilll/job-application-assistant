# ---------------------------------------------------------------------------
# Server environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3001

# Comma-free single origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (added in Phase 2).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWTs (added in Phase 3). Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key from Google AI Studio (added in Phase 5).
GEMINI_API_KEY=your-gemini-api-key

# Gemini model name — kept as config, never hardcoded across the code.
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Database TLS (see src/db/pool.ts)
#
# Leave both unset for a provider with a publicly trusted certificate (Neon).
#
# For Amazon RDS, which signs with its own CA that Node does not trust:
#   curl -o certs/rds-global-bundle.pem \
#     https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DATABASE_CA_FILE=certs/rds-global-bundle.pem
#
# Only when reaching a private instance through an SSM port forward: the
# certificate names the RDS endpoint but you dial localhost, so tell the client
# which name to verify against rather than turning verification off.
# DATABASE_TLS_SERVERNAME=your-db.abc123.ap-south-1.rds.amazonaws.com
