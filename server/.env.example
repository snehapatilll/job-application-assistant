# ---------------------------------------------------------------------------
# Server environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3001

# Comma-free single origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (added in Phase 2).
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret used to sign JWTs (added in Phase 3). Use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Google Gemini API key from Google AI Studio (added in Phase 5).
GEMINI_API_KEY=your-gemini-api-key

# Gemini model name — kept as config, never hardcoded across the code.
GEMINI_MODEL=gemini-3.8-flash
