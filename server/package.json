{
  "name": "job-application-assistant-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the AI-Powered Job Application Assistant",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test \"tests/unit/**/*.test.ts\" \"tests/api/**/*.test.ts\"",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:live": "tsx --test \"tests/live/**/*.test.ts\"",
    "db:setup": "tsx src/scripts/setupDb.ts",
    "db:verify": "tsx src/scripts/verifyDb.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
